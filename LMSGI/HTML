<!DOCTYPE html> <!-- ESTO SIEMPRE -->

<html> 

<head> 
    <title>Apuntes HTML</title> <!-- Titulo que ira en la cabecera de la web-->
    <script></script> <!-- Contenido debe ir entre comentario-->
    <style></style> <!-- Estilo aplicado a CSS. Contenido entre comentario-->
    <base></base> <!-- URI base del doc-->
    <link></link> <!-- Enlaces a docs externos de librerias-->
    <meta charset="UTF-8"></meta> <!-- Para que los acentos se vean UF-8 -->
</head>

    <body>

        <h1> H1 </h1> 
        <h2> H2 </h2>
        <h3> H3 </h3>
        <h4> H4 </h4>
        <h5> H5 </h5>
        <h6> H6 </h6>
        <!-- Estos elementos son encabezados -->
        
        <p> Esto es un elemento que agrupa texto </p>

        <br> <!-- Este elemento da un salto de linea -->

        &nbsp; <!-- Sirve para dar varias tabulaciones y dejar mucho espacio -->

        <!-- 
        Los comentarios
        Tambien
        Pueden ser asi-->

        <a href="https://www.google.com/"> Te lleva a un hipervinculo </a> 
        <!-- Atributo mas importante es href que indica la URL,
        pero a veces se usa href="#" para 
        la misma pagina -->
        <!-- El atributo target permite elegir donde abrira el vinculo,
        target="_blank" abre en una nueva ventana/pestana
        target="_self" abre en la misma. Valor predeterminado
         -->

        <br>
        <br>

        <strong> Texto marcado importante </strong>

        <br>
        <br>

        <em> Indica enfasis </em>

        <br>
        <br>

        <small> Letra pequeña </small>

        <br>
        <br>



        <!-- Para hacer listas : -->

        <h3> Lista desordenada </h3>
        <ul> 
            <li> Pan </li>
            <li> Leche </li>
            <li> Huevos </li>
        </ul>
        <!-- ul delimita elementos de lista desordenada -->
        <!-- li marca como una lista de compra -->


        <h3> Lista ordenada </h3>
        <ol>
            <li> Pan </li>
            <li> Leche </li>
            <li> Huevos </li>
        </ol>
        <!-- Para comenzar en un numero pondremos start="0" como atributo -->

        <h3> Lista de definicion </h3>
        <dl>
            <dt> Pan </dt>
            <dd> Pan </dd>
            <dt> Leche </dt>
            <dd> Leche </dd>
            <dt> Huevos </dt>
            <dd> Huevos </dd>
        </dl>

        <br>
        <br>
        <br>
        
        <!-- Para hacer tablas : -->

        <table>
            <caption>Tabla socios </caption>
                <tr>    
                    <th> Nombre </th> 
                    <th> Apellido </th> 
                    <th> Edad </th>
                </tr>
                <tr>
                    <td> Juan </td> 
                    <td> Puertas </td>
                    <td> 54 </td>
                </tr>
                <tr>
                    <td> Eva </td>
                    <td> Montes </td>
                    <td> 44 </td>
                </tr>
        </table>
        <!-- table contiene todos los elementos -->
        <!-- caption anade leyenda a la tabla -->
        <!-- tr son las filas que hay en la tabla -->
        <!-- th es la cabecera, por eso resalta-->
        <!-- td son datos que hay en las celdas -->
        <!-- Atributos como coldgroup, tbody, thead, tfoot no son obligatorios-->

        <br>
        <br>

        <!-- Para hacer formularios : -->



    </body>

</html>
